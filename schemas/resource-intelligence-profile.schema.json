{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessli:schema:resource-intelligence-profile:v1",
  "title": "Tessli Resource Intelligence Profile",
  "description": "Versioned intelligence metadata for one Tessli catalogue resource. Kept separate from the Phase 1 public catalogue contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "resourceId",
    "status",
    "verifiedAt",
    "capabilities",
    "contentObjects",
    "platforms",
    "frameworks",
    "designTools",
    "deliveryFormats",
    "integrationMethods",
    "agentInterfaces",
    "discovery",
    "workflowFit",
    "limitations",
    "governance",
    "evidence"
  ],
  "properties": {
    "profileVersion": {
      "type": "integer",
      "const": 1
    },
    "resourceId": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "needs-review",
        "archived"
      ]
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "contentObjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "website",
          "page",
          "section",
          "component",
          "template",
          "product-flow",
          "design-system",
          "pattern",
          "font",
          "icon",
          "illustration",
          "asset",
          "motion-example",
          "code",
          "documentation",
          "course",
          "article",
          "tool"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "web",
          "mobile",
          "desktop",
          "email",
          "presentation",
          "print",
          "cross-platform"
        ]
      }
    },
    "frameworks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "designTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "deliveryFormats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "web-page",
          "screenshot",
          "source-link",
          "source-code",
          "package",
          "figma-file",
          "design-file",
          "template",
          "downloadable-asset",
          "documentation",
          "structured-data",
          "generated-output"
        ]
      }
    },
    "integrationMethods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "website",
          "browser-extension",
          "plugin",
          "api",
          "mcp",
          "cli",
          "sdk",
          "npm-package",
          "github",
          "manual-download",
          "oauth"
        ]
      }
    },
    "agentInterfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agentInterface"
      }
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "workflowFit": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "humanReview": {
      "$ref": "#/$defs/humanReview"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "absoluteHttpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "agentInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "transport",
        "authentication",
        "credentialOwner",
        "dataReturned",
        "persistencePolicy",
        "status"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "mcp",
            "api",
            "cli",
            "sdk",
            "plugin"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "http",
            "sse",
            "stdio",
            "websocket",
            "local-process",
            "in-product"
          ]
        },
        "endpoint": {
          "$ref": "#/$defs/absoluteHttpUrl"
        },
        "authentication": {
          "type": "string",
          "enum": [
            "none",
            "bearer-token",
            "api-key",
            "oauth",
            "session",
            "unknown"
          ]
        },
        "credentialOwner": {
          "type": "string",
          "enum": [
            "none",
            "user",
            "workspace",
            "tessli-organization",
            "unknown"
          ]
        },
        "dailyRequestLimit": {
          "type": "integer",
          "minimum": 0
        },
        "burstPerMinute": {
          "type": "integer",
          "minimum": 0
        },
        "dataReturned": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "persistencePolicy": {
          "$ref": "#/$defs/persistencePolicy"
        },
        "status": {
          "type": "string",
          "enum": [
            "documented",
            "tested",
            "unavailable",
            "unknown"
          ]
        },
        "documentationUrl": {
          "$ref": "#/$defs/absoluteHttpUrl"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textSearch",
        "facets"
      ],
      "properties": {
        "textSearch": {
          "type": "boolean"
        },
        "semanticSearch": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "facets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "persistencePolicy": {
      "type": "string",
      "enum": [
        "persistent",
        "metadata-only",
        "transient",
        "prohibited",
        "unknown"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultPersistence",
        "assetRedistribution",
        "sourceAttribution",
        "userCredentialRequired",
        "termsReviewRequired"
      ],
      "properties": {
        "defaultPersistence": {
          "$ref": "#/$defs/persistencePolicy"
        },
        "assetRedistribution": {
          "type": "string",
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown"
          ]
        },
        "sourceAttribution": {
          "type": "string",
          "enum": [
            "required",
            "recommended",
            "not-required",
            "unknown"
          ]
        },
        "userCredentialRequired": {
          "type": "boolean"
        },
        "termsReviewRequired": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "sourceUrl",
        "sourceType",
        "verifiedAt"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceUrl": {
          "$ref": "#/$defs/absoluteHttpUrl"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "official-documentation",
            "official-product-page",
            "official-legal-page",
            "repository",
            "manual-test",
            "other"
          ]
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "certain",
            "likely",
            "unknown"
          ]
        }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewerId",
        "reviewedAt",
        "verificationRecordPath"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "completed"
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\s]+$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "verificationRecordPath": {
          "type": "string",
          "pattern": "^verification-records/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
        }
      }
    }
  }
}
