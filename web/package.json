{
  "name": "tessli-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "catalogue:generate": "node scripts/generate-catalogue.mjs",
    "catalogue:check": "node scripts/check-catalogue.mjs",
    "profiles:generate": "node scripts/generate-intelligence-profiles.mjs",
    "profiles:check": "node scripts/check-intelligence-profiles.mjs",
    "source-profiles:check": "node scripts/check-source-profile-contract.mjs",
    "verification:draft": "node scripts/resource-verification.mjs draft",
    "verification:check": "node scripts/resource-verification.mjs check",
    "verification:promotions:generate": "node scripts/generate-verification-promotions.mjs --generate",
    "verification:promotions:check": "node scripts/generate-verification-promotions.mjs --check",
    "media:review:generate": "node scripts/generate-resource-media-review.mjs",
    "media:review:check": "node scripts/check-resource-media-candidates.mjs",
    "media:coverage:generate": "node scripts/generate-resource-media-coverage.mjs",
    "media:coverage:check": "node scripts/check-resource-media-coverage.mjs",
    "media:batch:select": "node scripts/select-resource-media-batch.mjs",
    "media:discover": "node scripts/discover-resource-media.mjs",
    "media:preview:pilot": "node scripts/capture-resource-preview-pilot.mjs",
    "media:preview:interaction-pilot": "node scripts/capture-resource-preview-interaction-pilot.mjs",
    "media:preview:overlay-verification": "node scripts/capture-resource-preview-overlay-verification.mjs",
    "mcp": "node mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && node scripts/check-intelligence-profiles.mjs && node scripts/check-source-profile-contract.mjs && node scripts/generate-verification-promotions.mjs --check && node scripts/check-resource-media-candidates.mjs && node scripts/check-resource-media-coverage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.17.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.1.0"
  }
}
